  "blocks": [
    { "page_no": 36, "seq": 1, "type": "chapter_title", "body_html": "<span class=\"ch-no\">6</span> LES POSSESSIFS" },
    { "page_no": 36, "seq": 2, "type": "keypoint", "body_html": "– C'est <strong>mon</strong> sac.&nbsp;&nbsp;&nbsp;&nbsp;C'est <strong>ma</strong> montre.&nbsp;&nbsp;&nbsp;&nbsp;Ce sont <strong>mes</strong> livres.<br>– C'est <strong>le mien</strong>.&nbsp;&nbsp;&nbsp;&nbsp;C'est <strong>la mienne</strong>.&nbsp;&nbsp;&nbsp;&nbsp;Ce sont <strong>les miens</strong>." },
    { "page_no": 36, "seq": 3, "type": "section_title", "body_html": "L'ADJECTIF POSSESSIF" },
    { "page_no": 36, "seq": 4, "type": "para", "body_html": "s'accorde avec le <strong>nom</strong> possédé et change avec le <strong>possesseur</strong> :" },
    { "page_no": 36, "seq": 5, "type": "table", "body_html": "<div class='two-col'><div><span class='lead'>&nbsp;</span><span class='wordlist'>Je<br>Tu<br>Il/Elle<br>Nous<br>Vous<br>Ils/Elles</span></div><div><span class='lead'>nom masculin</span><span class='wordlist'><em><strong>mon</strong> père</em><br><em><strong>ton</strong> fils</em><br><em><strong>son</strong> cousin</em><br><em><strong>notre</strong> père</em><br><em><strong>votre</strong> fils</em><br><em><strong>leur</strong> cousin</em></span></div><div><span class='lead'>nom féminin</span><span class='wordlist'><em><strong>ma</strong> mère</em><br><em><strong>ta</strong> fille</em><br><em><strong>sa</strong> cousine</em><br><em><strong>notre</strong> mère</em><br><em><strong>votre</strong> fille</em><br><em><strong>leur</strong> cousine</em></span></div><div><span class='lead'>nom pluriel</span><span class='wordlist'><em><strong>mes</strong> parents</em><br><em><strong>tes</strong> enfants</em><br><em><strong>ses</strong> cousin(e)s</em><br><em><strong>nos</strong> parents</em><br><em><strong>vos</strong> enfants</em><br><em><strong>leurs</strong> cousin(e)s</em></span></div></div>" },
    { "page_no": 36, "seq": 6, "type": "warning", "body_html": "<p class='bullet'><em><strong>On</strong> est chez <strong>notre</strong> grand-mère.</em>&nbsp;&nbsp;&nbsp;&nbsp;(« on » = « nous »)<br><em>Quand <strong>on</strong> est vieux, on parle de <strong>son</strong> passé.</em>&nbsp;&nbsp;&nbsp;&nbsp;(« on » = « tout le monde »)</p>" },
    { "page_no": 36, "seq": 7, "type": "para", "body_html": "<p class='bullet'>Pour les parties du corps, on remplace le possessif par l'article défini quand il est évident que le possesseur est le sujet de la phrase :</p><p class='sample'><em><strong>Ma</strong> tête est brûlante.</em>&nbsp;&nbsp;&nbsp;&nbsp;<em>J'ai mal à <strong>la</strong> tête. (à la tête)</em></p>" },
    { "page_no": 36, "seq": 8, "type": "phonetic", "body_html": "<p class='bullet'><strong>La liaison</strong> avec une voyelle est obligatoire, sauf devant « <strong>h</strong> » aspiré :</p><span class='example-line'><em>mon</em><span class='liaison'>n</span><em>ami</em>&nbsp;&nbsp;&nbsp;&nbsp;<em>mes</em><span class='liaison'>z</span><em>idées</em>&nbsp;&nbsp;&nbsp;&nbsp;<em>mes | héros préférés</em></span>" },
    { "page_no": 36, "seq": 9, "type": "phonetic", "body_html": "<p class='bullet'>« <strong>Ma, ta, sa</strong> » deviennent « <strong>mon, ton, son</strong> » devant voyelle ou « <strong>h</strong> » muet :</p><p class='sample'><em><strong>mon</strong> amie</em>&nbsp;&nbsp;&nbsp;&nbsp;<em><strong>ton</strong> erreur</em>&nbsp;&nbsp;&nbsp;&nbsp;<em><strong>son</strong> hésitation</em></p>" },
    { "page_no": 36, "seq": 10, "type": "section_title", "body_html": "LE PRONOM POSSESSIF" },
    { "page_no": 36, "seq": 11, "type": "para", "body_html": "change selon le nom qu'il remplace." },
    { "page_no": 36, "seq": 12, "type": "table", "body_html": "<div class='two-col'><div><span class='lead'>masc. sing.</span><span class='wordlist'><em>le mien</em><br><em>le tien</em><br><em>le sien</em><br><em>le nôtre</em><br><em>le vôtre</em><br><em>le leur</em></span></div><div><span class='lead'>fém. sing.</span><span class='wordlist'><em>la mienne</em><br><em>la tienne</em><br><em>la sienne</em><br><em>la nôtre</em><br><em>la vôtre</em><br><em>la leur</em></span></div><div><span class='lead'>masc. plur.</span><span class='wordlist'><em>les miens</em><br><em>les tiens</em><br><em>les siens</em><br><em>les nôtres</em><br><em>les vôtres</em><br><em>les leurs</em></span></div><div><span class='lead'>fém. plur.</span><span class='wordlist'><em>les miennes</em><br><em>les tiennes</em><br><em>les siennes</em><br><em>les nôtres</em><br><em>les vôtres</em><br><em>les leurs</em></span></div></div>" },
    { "page_no": 36, "seq": 13, "type": "warning", "body_html": "<p class='bullet'><em>notre</em> : adjectif&nbsp;&nbsp;&nbsp;&nbsp;<em>le nôtre</em> : pronom</p>" }
  ],
