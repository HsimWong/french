# francais.service — 资源受限的 systemd 单元（VPS / Linux 用）
#
# 安装：
#   sudo cp deploy/francais.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now francais
#
# 看日志：
#   journalctl -u francais -f
#
# ---------------------------------------------------------------------------
# 当前线上实例（2026-11-17 起）
# ---------------------------------------------------------------------------
#   服务器   47.94.236.198
#   部署目录 /home/admin/maintain/french
#   监听端口 8082（nginx location /french/ → proxy_pass 127.0.0.1:8082）
#   日志     journalctl -u francais -f
#
# 下面的路径按线上实际目录写死了。换目录部署时，这几行要一起改：
#   WorkingDirectory / ExecStart / DB_PATH
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# 内存怎么限
# ---------------------------------------------------------------------------
#   MemoryMax=     硬上限。超过就触发 OOM killer，进程被内核杀掉（不是优雅退出）。
#                  设成应用真实峰值的 1.3~1.5 倍，不要贴着设。
#   MemoryHigh=    软上限。超过后内核开始回收并节流进程，让它自己降下来。
#                  这条是"温和"的那道闸，通常应该先撞它而不是 MemoryMax。
#   MemorySwapMax=0  禁用 swap 交换。SQLite 在有 swap 的机器上被换出会慢到
#                  看起来像卡死，所以宁可 OOM 也不要 swap。
#
#   注意：这里的限制作用于 cgroup 内的全部进程。systemd 的 MemoryMax 只统计
#   匿名页 + page cache，不统计进程通过 mmap 映射的可执行文件段，所以它与
#   "任务管理器里看到的内存"不是一个数。
#
# ---------------------------------------------------------------------------
# CPU 怎么限
# ---------------------------------------------------------------------------
#   CPUQuota=50%    相当于 0.5 个核。100% = 1 个核，200% = 2 个核。
#   CPUWeight=      相对权重，只有在多个服务抢 CPU 时才起作用，不是硬上限。
#   TasksMax=       限制线程数。Go 服务的线程数 = GOMAXPROCS + 网络栈 + GC，
#                   设太小会让 GC 卡住。
#
# ---------------------------------------------------------------------------
# 一个必须知道的坑
# ---------------------------------------------------------------------------
#   不要用 `ulimit -v` 给 Go 程序限内存。Go 运行时会把大块虚拟地址空间保留
#   在自己手里（arena），ulimit -v 限制的是虚拟地址空间总量，Go 一旦申请
#   不到地址就直接 panic 退出，看起来像"内存限制把程序搞崩了"。
#   cgroup 的 memory.max 限制的是实际占用（RSS），对 Go 是正确的做法。
#
[Unit]
Description=Français Progressif - cours de grammaire et vocabulaire
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/admin/maintain/french
ExecStart=/home/admin/maintain/french/bin/french

# --- 环境变量 ---
# DB_PATH 指向真实的库文件。相对路径相对于 WorkingDirectory 解析，
# 所以这里用绝对路径最省心。
#
# PORT 必须和 nginx 的 proxy_pass 一致。你现在的 nginx 写的是 8082，
# 这里就必须是 8082；直接跑 ./bin/francais 而不设 PORT，会监听默认的 8080，
# nginx 转 8082 就得到 502。
Environment=DB_PATH=/home/admin/maintain/french/french.db
Environment=PORT=8082
# Go 堆软上限。这一条管 Go 自己的堆，MemoryHigh 管整个进程。
Environment=MEM_LIMIT_MB=420
# Go 并行度。这是 Go 程序真正的 CPU 阀门：即使机器有 8 核，
# 同时最多只有 2 个线程在跑 Go 代码。
Environment=GOMAXPROCS=2
# 让 GC 更早介入，配合 MEM_LIMIT_MB 效果更好。
Environment=GOGC=50
# 用 `-tags noseed` 构建（词典不进二进制）时，指定词典文件位置。
# 用默认构建（词典已嵌入）时这一行可以删掉 —— 线上当前用的是默认构建。
Environment=LEXICON_SEED_FILE=/home/admin/maintain/french/data/lexicon_seed.json

# --- 内存限制 ---
MemoryHigh=600M
MemoryMax=800M
MemorySwapMax=0

# --- CPU 限制 ---
CPUQuota=100%
CPUWeight=50
TasksMax=512

# --- 其它 ---
Restart=always
RestartSec=5
# 给足时间写完 WAL 再杀
TimeoutStopSec=30
KillSignal=SIGTERM
LimitNOFILE=8192

StandardOutput=journal
StandardError=journal
SyslogIdentifier=francais

[Install]
WantedBy=multi-user.target
