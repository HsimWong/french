# Français Progressif 运行配置模板
# 复制为 .env 后按需修改；本机进程和有 EnvironmentFile 的 systemd 都读这个文件。
# 优先级：真实环境变量（shell / systemd / docker -e）> .env > 代码默认值。

# ---- 监听地址 ----
# ADDR 是完整的 listen 地址。":8082" = 所有网卡；"127.0.0.1:8082" = 只给 nginx 本机反代；
# "[::1]:8082" 是 IPv6。也可以只写端口（如 8082），等价于 ":8082"。
ADDR=:8082
# ADDR 为空时才用下面两项拼地址；一般不用改。
BIND_HOST=
PORT=8082

# ---- 数据库 ----
# 用绝对路径，避免工作目录变化时凭空建出空库。
DB_PATH=

# ---- 访问口令 ----
# 留空 = 不启用口令（服务完全开放）。改口令后旧 cookie 自动失效。
ACCESS_PASSCODE=

# ---- Go 运行时 / 小内存 VPS ----
MEM_LIMIT_MB=420
GOMAXPROCS=2
GOGC=50

# ---- 仅 -tags noseed 构建需要（默认构建词典已嵌入二进制，保持注释即可）----
# LEXICON_SEED_FILE=/home/admin/maintain/french/data/lexicon_seed.json
