# Français Progressif 运行配置模板
# 复制为 .env 后按需修改；本机进程和有 EnvironmentFile 的 systemd 都读这个文件。
# 优先级：真实环境变量（shell / systemd / docker -e）> .env > 代码默认值。

# ---- 监听地址 ----
# ADDR 是完整的 listen 地址。":8082" = 所有网卡；"127.0.0.1:8082" = 只给 nginx 本机反代；
# "[::1]:8082" 是 IPv6。也可以只写端口（如 8082），等价于 ":8082"。
ADDR=:8082
# ADDR 为空时才用下面两项拼地址；一般不用改。
BIND_HOST=
PORT=8082

# ---- 数据库 ----
# 用绝对路径，避免工作目录变化时凭空建出空库。
DB_PATH=/home/admin/maintain/french/french.db

# ---- 访问口令 ----
# 改口令后旧 cookie 自动失效。不要留空：留空会让服务拒绝启动（fail-closed）。
# 本文件在公开仓库中，务必只放占位符；真实值写在本机/服务器的 .env（已 gitignore）。
ACCESS_PASSCODE=CHANGE_ME_TO_A_LONG_RANDOM_PASSCODE
# 默认 1：ACCESS_PASSCODE 为空时拒绝启动，避免复制模板后裸奔。
# 只有明确要公开访问时才改成 0。
REQUIRE_PASSCODE=1

# ---- 每日练习发布令牌（独立于网站口令）----
# 仅供定时任务调用 POST /api/speaking/ingest，不能登录网站、提交修改或上传视频。
# 与 ACCESS_PASSCODE 不同；留空则禁用该接口。真实值只写 .env，绝不提交。
SPEAKING_INGEST_TOKEN=

# ---- Go 运行时 / 小内存 VPS ----
MEM_LIMIT_MB=420
GOMAXPROCS=2
GOGC=50

# ---- 词典（运行时数据文件，默认构建不包含在二进制里）----
# 首次启动时导入数据库；之后靠指纹判断，重复启动不会再导入。
# 换目录时这里的路径要跟着 DEST 改；make install 会自动按 DEST 渲染。
LEXICON_SEED_FILE=/home/admin/maintain/french/data/lexicon_seed.json

# ---- 镜头练习视频 ----
# 视频按文件存储（不写进 french.db，避免 150MB 主库膨胀）；数据库只存元数据。
# 目录会被自动创建，需确保运行用户有写权限。
SPEAKING_VIDEO_DIR=/home/admin/maintain/french/data/speaking-videos
